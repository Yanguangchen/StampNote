rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Main superadmins are verified Google accounts listed here. Explicit
      // admin/superadmin custom claims remain supported for future accounts.
      return isSignedIn()
        && (
          (
            request.auth.token.email_verified == true
            && request.auth.token.email in [
              "yanguangchensp@gmail.com",
              "shen.hocklim@gmail.com"
            ]
          )
          || request.auth.token.stampnoteRole in ["admin", "superadmin"]
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasValidAttendanceReviewState() {
      return (
        request.resource.data.source == "face-match"
        && request.resource.data.reviewStatus == "clear"
      ) || (
        request.resource.data.source == "manual"
        && request.resource.data.reviewStatus == "flagged"
        && request.resource.data.reviewReason == "manual-entry"
      );
    }

    // Field staff keep their own photo uploads. Administrators can review and
    // delete every account's photos from Photos & attendance.
    match /users/{userId}/photos/{photoId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Face templates are a shared roster: recording needs every enrolled worker,
    // but only an administrator may enroll or delete them.
    match /users/{userId}/workers/{workerId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isOwner(userId)
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAdmin() && isOwner(userId);
    }

    match /{path=**}/photos/{photoId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /{path=**}/workers/{workerId} {
      allow read: if isSignedIn();
    }

    match /workers/{workerId} {
      allow read: if isSignedIn();
      allow delete: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create, update: if isAdmin()
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /{path=**}/entries/{entryId} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn() && hasValidAttendanceReviewState();
      allow delete: if isAdmin();
    }

    match /attendanceDays/{dateKey} {
      allow read: if isAdmin();
      match /entries/{entryId} {
        allow read: if isAdmin();
        allow create, update: if isSignedIn() && hasValidAttendanceReviewState();
        allow delete: if isAdmin();
      }
    }

    // Recording writes GPS onto the session document; only administrators
    // browse or delete the dashboard itself.
    match /dashboardSessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // A live recording publishes its camera so an administrator can tunnel in
    // without a call prompt. The owner heartbeats the document; viewer docs are
    // WebRTC offers the recording answers automatically.
    match /liveTunnels/{tunnelId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "live";
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      match /viewers/{viewerId} {
        allow read: if isAdmin()
          || (isSignedIn() && resource.data.publisherUid == request.auth.uid);
        allow create: if isAdmin()
          && request.resource.data.viewerUid == request.auth.uid
          && request.resource.data.publisherUid is string;
        allow update: if (isAdmin() && resource.data.viewerUid == request.auth.uid)
          || (isSignedIn() && resource.data.publisherUid == request.auth.uid);
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.publisherUid == request.auth.uid);

        match /ice/{iceId} {
          allow read: if isAdmin()
            || (isSignedIn() && resource.data.publisherUid == request.auth.uid);
          allow create: if isSignedIn()
            && request.resource.data.publisherUid is string
            && request.resource.data.from in ["publisher", "viewer"]
            && (
              (
                request.resource.data.from == "publisher"
                && request.resource.data.publisherUid == request.auth.uid
              ) || (
                isAdmin()
                && request.resource.data.from == "viewer"
                && request.resource.data.viewerUid == request.auth.uid
              )
            );
          allow delete: if isAdmin()
            || (isSignedIn() && resource.data.publisherUid == request.auth.uid);
        }
      }
    }

    match /{collection}/{document=**} {
      allow read, write: if isAdmin()
        && collection != "users"
        && collection != "workers"
        && collection != "attendanceDays"
        && collection != "dashboardSessions"
        && collection != "liveTunnels";
    }
  }
}
