rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Signed-in accounts are superadmins unless explicitly marked worker.
      return isSignedIn() && request.auth.token.stampnoteRole != "worker";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Field staff keep their own photo uploads. Administrators can review and
    // delete every account's photos from Photos & attendance.
    match /users/{userId}/photos/{photoId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Face templates are a shared roster: recording needs every enrolled worker,
    // but only an administrator may enroll or delete them.
    match /users/{userId}/workers/{workerId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isOwner(userId)
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAdmin() && isOwner(userId);
    }

    match /{path=**}/photos/{photoId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /{path=**}/workers/{workerId} {
      allow read: if isSignedIn();
    }

    match /workers/{workerId} {
      allow read: if isSignedIn();
      allow delete: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create, update: if isAdmin()
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /{path=**}/entries/{entryId} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /attendanceDays/{dateKey} {
      allow read: if isAdmin();
      match /entries/{entryId} {
        allow read: if isAdmin();
        allow create, update: if isSignedIn();
        allow delete: if isAdmin();
      }
    }

    // Recording writes GPS onto the session document; only administrators
    // browse or delete the dashboard itself.
    match /dashboardSessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /{collection}/{document=**} {
      allow read, write: if isAdmin()
        && collection != "users"
        && collection != "workers"
        && collection != "attendanceDays"
        && collection != "dashboardSessions";
    }
  }
}
