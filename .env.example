# Copy this file to .env.local and fill in secrets there. Never commit .env.local.

# CURRENT STAMPNOTE PROVIDER — Google AI Studio / direct Gemini API
# Create the key in Google AI Studio. This secret is read only by the server.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional local server port. StampNote defaults to 8080.
STAMPNOTE_PORT=8080

# Firebase's browser project configuration lives in firebase.js and is public
# by design. Do not add Firebase user credentials, tokens, or service-account
# keys here; the browser uses Google sign-in and owner-only Firestore rules.
