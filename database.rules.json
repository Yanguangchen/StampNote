{
  "rules": {
    ".read": "auth != null && auth.token.stampnoteRole !== 'worker'",
    ".write": "auth != null && auth.token.stampnoteRole !== 'worker'",
    "attendanceDays": {
      "$date": {
        "entries": {
          ".indexOn": ["checkedInAtMs", "workerId", "location"]
        }
      }
    }
  }
}
